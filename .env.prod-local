# Local production-like environment — secure defaults, no real secrets
ENVIRONMENT=production
DEBUG=false
APP_NAME=Security SaaS API
APP_VERSION=1.0.0

DATABASE_URL=postgresql://security:security_password@postgres:5432/security_saas
RLS_ENABLED=true
RBAC_STRICT_MODE=true
AUDIT_METADATA_MAX_BYTES=4096

JWT_SECRET=change-this-in-production-generate-32-bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

FRONTEND_URL=http://localhost:3000
DOCKER_HOST=tcp://docker-socket-proxy:2375

SCANNER_MAX_ATTEMPTS=2
SCANNER_CONTROL_PLANE_ENABLED=true
AI_ENABLED=false
AI_PROVIDER=mock
AI_MODEL=mock-analyst

CONNECTOR_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
SECRET_STORE_MODE=production
REPOSITORY_PROVIDER_MODE=mock
CLOUD_PROVIDER_MODE=mock

# Production should use external KMS/Vault/HSM — this key is for local prod-like only
# Generate via: openssl rand -hex 32

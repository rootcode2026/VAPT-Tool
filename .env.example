# =========================================================
# APPLICATION
# =========================================================

APP_NAME=Security SaaS API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false


# =========================================================
# DATABASE
# =========================================================

DATABASE_URL=postgresql://security:security_password@postgres:5432/security_saas

# Row-Level Security — defense-in-depth, preparation only (default OFF).
# When false, the RLS helper is a no-op and app-layer authorization is authoritative.
# No table has RLS enabled and no policies are created in this phase.
RLS_ENABLED=false

# RBAC strict mode — when true, missing project membership is DENIED for all projects.
# When false (default, transitional), projects without explicit memberships use org fallback.
RBAC_STRICT_MODE=false

# Audit logging — metadata size limit to prevent storage DoS
AUDIT_METADATA_MAX_BYTES=4096
AUDIT_LOGGING_ENABLED=true


# =========================================================
# AUTHENTICATION
# =========================================================

JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional local bootstrap. Leave empty in production.
# When both email and password are set and no matching user exists,
# the API creates an organization member on startup.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_ORG_NAME=Organization


# =========================================================
# REDIS
# =========================================================

REDIS_URL=redis://redis:6379/0


# =========================================================
# RABBITMQ
# =========================================================

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//


# =========================================================
# CELERY
# =========================================================

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0


# =========================================================
# FRONTEND / CORS
# =========================================================

FRONTEND_URL=http://localhost:3000


# =========================================================
# DOCKER
# =========================================================

DOCKER_HOST=tcp://docker-socket-proxy:2375


# =========================================================
# SCANNERS
# =========================================================

NMAP_IMAGE=vapt-tool-nmap
NUCLEI_IMAGE=vapt-tool-nuclei
SCANNER_MAX_ATTEMPTS=2
# SAST fallback — when false (default), Semgrep Docker failure fails the scan
# instead of silently falling back to local analyzer. Set to true only for
# development/test where Docker is unavailable. Provenance will be
# execution_engine=sast_analyzer when fallback is used.
SAST_FALLBACK_ENABLED=false
SAST_IMAGE=vapt-sast:latest
# S7.5 Secrets scanner — Gitleaks v8.30.1
# SECRETS_IMAGE: Docker image for secrets detection (default: vapt-secrets:latest)
# SECRETS_TIMEOUT: Max scan duration in seconds (default: 120)
# SECRETS_FALLBACK_ENABLED: When true, allows fallback to official image.
#   Must remain false in production to prevent silent detection downgrade.
SECRETS_IMAGE=vapt-secrets:latest
SECRETS_TIMEOUT=120
SECRETS_FALLBACK_ENABLED=false
# S7.6 Container scanner — Trivy 0.66.0
# CONTAINER_IMAGE: Docker image for container scanning (default: vapt-container:latest)
# CONTAINER_TIMEOUT: Max scan duration in seconds (default: 300)
# CONTAINER_FALLBACK_ENABLED: When true, allows fallback to official image.
#   Must remain false in production to prevent silent downgrade.
CONTAINER_IMAGE=vapt-container:latest
CONTAINER_TIMEOUT=300
CONTAINER_FALLBACK_ENABLED=false
# S7.7 IaC scanner — Checkov 3.3.16
# IAC_IMAGE: Docker image for IaC scanning (default: vapt-iac:latest)
# IAC_TIMEOUT: Max scan duration in seconds (default: 180)
# IAC_FALLBACK_ENABLED: When true, allows fallback to official image.
#   Must remain false in production to prevent silent downgrade.
IAC_IMAGE=vapt-iac:latest
IAC_TIMEOUT=180
IAC_FALLBACK_ENABLED=false
# S7.8 API scanner — vapt-api 1.0.0 (Python + spectral-like checks)
# API_IMAGE: Docker image for API scanning (default: vapt-api:latest)
# API_TIMEOUT: Max scan duration in seconds (default: 120)
# API_FALLBACK_ENABLED: When true, allows fallback to python base image.
#   Must remain false in production to prevent silent downgrade.
API_IMAGE=vapt-api:latest
API_TIMEOUT=120
API_FALLBACK_ENABLED=false


# =========================================================
# VULNERABILITY INTELLIGENCE
# =========================================================

NVD_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=


# =========================================================
# AI
# =========================================================

OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=